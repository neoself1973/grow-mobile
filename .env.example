# grow-mobile の環境変数（値は入れない。実物は .env.demo / .env.prod で、いずれも git 管理外）。
#
# 公開用（APK）は .env.demo だけを使う＝**本番に触れる経路はゼロ**（正本 §12-7）。
# 本人用は .env.prod（本番バックエンド）。本人の端末にしか入れない・配布しない。
#
# 起動:  npm run start:demo   （.env.demo を読む）
#        npm run web:demo     （Xcode / Android SDK 未導入の間の代替確認）

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=

# ★SUPABASE_SERVICE_ROLE_KEY と ANTHROPIC_API_KEY はここに置かない。
#   EXPO_PUBLIC_* はクライアントバンドルに埋まる＝配布物に鍵が乗る。
